rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.uid == "yZsy5oOxhjU7BFnaCH67FOL3rjB2";
    }


    // =========================
    // USERS
    // =========================

    match /users/{uid} {

      allow create: if signedIn()
        && request.auth.uid == uid;

      allow read, update: if signedIn()
        && request.auth.uid == uid;

      allow delete: if isOwner()
        && uid != request.auth.uid;
    }


    // =========================
    // REVIEWS
    // =========================

    match /reviews/{reviewId} {

      // Everyone can read reviews
      allow read: if true;

      // Only logged-in users can create reviews
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.text is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;

      // Only owner can delete reviews
      allow delete: if isOwner();

      // Reviews cannot be edited
      allow update: if false;
    }


    // =========================
    // DOWNLOAD COUNTER
    // =========================

    match /stats/{docId} {

      // Anyone can see total downloads
      allow read: if true;

      // First download
      allow create: if docId == "main"
        && signedIn()
        && request.resource.data.downloads == 1;

      // Every download increases exactly by 1
      allow update: if docId == "main"
        && signedIn()
        && request.resource.data.downloads
           == resource.data.downloads + 1;

      // Only owner can delete counter
      allow delete: if isOwner();
    }
  }
}
